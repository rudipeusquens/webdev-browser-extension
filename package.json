{
  "name": "webdev-browser-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension that turns highlights and comments on a web page into a prompt for an AI coding agent.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"scripts/**/*.test.mjs\" && vitest run",
    "test:unit": "vitest run",
    "secrets:check": "git ls-files -z | xargs -0 secretlint --maskSecrets",
    "privacy:check": "node scripts/privacy-check.mjs --all",
    "check": "pnpm lint && pnpm format:check && pnpm compile && pnpm test && pnpm secrets:check && pnpm privacy:check",
    "manifest:check": "node scripts/check-manifest.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "voice:fixtures": "node --env-file=.env scripts/voice-fixtures.mjs"
  },
  "lint-staged": {
    "*": [
      "secretlint --maskSecrets",
      "node scripts/privacy-check.mjs"
    ],
    "*.{js,mjs,cjs,ts,mts,cts,tsx,vue}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-pattern": "^13.0.6",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-rem-to-responsive-pixel": "^7.0.7",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "secretlint": "^13.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12",
    "wxt": "^0.21.4",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.50.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43"
  }
}
